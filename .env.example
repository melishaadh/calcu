# Copy this file to ".env" (same directory) and edit the values.
# Docker Compose loads ".env" automatically. ".env" is gitignored — real
# secrets never get committed.
#
#   cp .env.example .env

# ------------------------------------------------------------------
# Web entrypoint
# ------------------------------------------------------------------
# Host port the nginx gateway listens on.
#   local dev : 8081  -> http://localhost:8081  (8080 is reserved for Jenkins on this host)
#   EC2       : 80    -> http://<EC2 public IP>
HTTP_PORT=8081

# ------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------
POSTGRES_USER=calcu_user
# CHANGE THIS before deploying anywhere real. Generate one with:
#   openssl rand -base64 24
POSTGRES_PASSWORD=calcu_pass
POSTGRES_DB=calcu_db

# Local dev only (docker-compose.override.yml): the host port Postgres is
# published on, always bound to 127.0.0.1. Ignored on EC2.
POSTGRES_PORT=5432

# ------------------------------------------------------------------
# history-service connection pool (per Gunicorn worker).
# Raise only if you also raise Postgres max_connections.
# DB_INIT_RETRIES x 2s is how long the service waits for Postgres on startup.
# ------------------------------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_INIT_RETRIES=10

# ------------------------------------------------------------------
# Image tag applied to every locally-built image (calcu-<svc>:<IMAGE_TAG>).
# Leave as "latest" unless you are pinning a specific build.
# ------------------------------------------------------------------
IMAGE_TAG=latest
