# Force LF line endings for everything that runs on Linux / inside containers.
# Without this, a checkout on Windows (core.autocrlf=true) rewrites these files
# with CRLF, and then:
#   * shell scripts fail with "bad interpreter: /usr/bin/env bash^M"
#   * the systemd unit fails to parse
#   * Dockerfile RUN lines and docker-entrypoint scripts break
* text=auto eol=lf

*.sh            text eol=lf
*.py            text eol=lf
*.sql           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.conf          text eol=lf
*.service       text eol=lf
Dockerfile      text eol=lf
*.dockerignore  text eol=lf
Jenkinsfile     text eol=lf
.env.example    text eol=lf

# Binaries / generated documents — never touch line endings
*.png binary
*.jpg binary
*.gz  binary
*.pdf binary
*.doc binary
docs/*.html -text
